layout {

    focus-ring {
        active-color   "#babbf1"
        inactive-color "#000000"
        urgent-color   "#e78284"
    }

    border {
        active-color   "#babbf1"
        inactive-color "#000000"
        urgent-color   "#e78284"
    }

    shadow {
        color "#23263470"
    }

    tab-indicator {
        active-color   "#babbf1"
        inactive-color "#171be1"
        urgent-color   "#e78284"
    }

    insert-hint {
        color "#babbf180"
    }
}

recent-windows {
    highlight {
        active-color "#babbf1"
        urgent-color "#e78284"
    }
}
